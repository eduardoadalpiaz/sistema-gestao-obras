# {$DOMAIN} vem do .env (ex.: vm-obras-eduardo.northcentralus.cloudapp.azure.com).
# O Caddy pega o certificado HTTPS sozinho.
{$DOMAIN} {
	# /metrics é só para o Prometheus (rede interna): fora do servidor dá 404
	@metrics path /api/metrics /api/metrics/*
	handle @metrics {
		respond 404
	}

	# Grafana (painéis), protegido por login
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# /api/* vai para o back-end (sem o prefixo /api)
	handle_path /api/* {
		# flush_interval -1 mantém o tempo real (SSE) sem atraso
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	# o resto é o site (React)
	handle {
		# comprime as respostas
		encode gzip
		root * /srv
		# qualquer rota do React cai no index.html (SPA)
		try_files {path} /index.html
		# entrega os arquivos do site
		file_server
	}

	# cabeçalhos de segurança em toda resposta
	header {
		# impede o navegador de adivinhar o tipo do arquivo
		X-Content-Type-Options nosniff
		# proíbe abrir o site dentro de iframe (clickjacking)
		X-Frame-Options DENY
		# limita o que é enviado a outros sites
		Referrer-Policy strict-origin-when-cross-origin
		# desliga câmera, microfone e localização
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# força HTTPS por 1 ano
		Strict-Transport-Security "max-age=31536000"
	}
}

# Staging: a mesma versão que vai para a produção, testada antes (porta 8443).
# O certificado HTTPS é o mesmo do domínio.
{$DOMAIN}:8443 {
	# encaminha tudo para o container do staging
	reverse_proxy staging-web:8081

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
