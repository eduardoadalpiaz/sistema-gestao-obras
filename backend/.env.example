# Conexão com o PostgreSQL (em produção o docker-compose monta isso sozinho)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/obras
# true quando o banco exige SSL (no docker-compose é false)
DATABASE_SSL=false

# Segredo que assina o token de login. Use algo longo e aleatório. Pra gerar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem ele o servidor cria um temporário a cada início (os logins caem quando reinicia).
JWT_SECRET=

PORT=3001

# Endereço do front que pode chamar a API (em produção, o endereço do site). Pode ter mais de um, separados por vírgula.
CORS_ORIGIN=http://localhost:5173

# Análise por IA (Google Gemini), opcional.
# Chave grátis em https://aistudio.google.com/apikey
# Sem a chave o sistema funciona normal, só o botão "Gerar Análise" avisa
# que a IA não está configurada.
GEMINI_API_KEY=
# Modelo usado (opcional). O Google desliga modelos antigos de tempos em tempos,
# então se a análise parar de funcionar veja o modelo atual em
# https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-3.5-flash-lite
